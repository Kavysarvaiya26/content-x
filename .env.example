# Backend
APP_ENV=development
SECRET_PROTECTION=1
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./data/transformai.db
MAX_UPLOAD_MB=10
DEMO_ACCESS_TOKEN=

# LLM — Groq by default; leave key empty to use extractive fallback (offline demo)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_CONCURRENCY=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
